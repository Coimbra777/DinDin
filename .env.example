APP_NAME="Painel Administrativo"
APP_ENV=development
# Gere com: php artisan key:generate  (nunca commite um APP_KEY real)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# CORS: origens separadas por vírgula (vazio = usa só APP_URL). Evite * em produção.
# CORS_ALLOWED_ORIGINS=http://localhost:8004,http://127.0.0.1:8004

# Front / SEO (opcional): handle Twitter para meta twitter:site (ex: @MinhaMarca)
# CMS_TWITTER_SITE=

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=mysql_nova_base
DB_PORT=3306
DB_DATABASE=nova_base
DB_USERNAME=root
DB_PASSWORD=123456

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=30
# Cookies: em produção HTTPS use true; SameSite lax reduz risco CSRF cross-site (override com strict se necessário)
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Seed do usuário admin (opcional)
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@example.com"

# Logos do painel AdminLTE (caminhos relativos a /public)
# CMS_ADMIN_LOGO=/img/logo_cms.svg
# CMS_ADMIN_LOGO_MINI=/img/logo_cms.svg
# Logo extra no header (data compartilhada / componentes)
# CMS_HEADER_LOGO=img/logo_cms.svg

# API de e-mail externa (opcional - use Laravel Mail quando possível)
# MAIL_API_ENABLED=false
# MAIL_API_URL=
# MAIL_API_AUTHENTICATOR=
# MAIL_API_FROM_ADDRESS=
# MAIL_API_FROM_NAME=
# MAIL_API_DEFAULT_RECIPIENT=
# MAIL_API_BASE_URL=
# MAIL_CRM_API_URL=
# MAIL_CRM_API_AUTH=

# Finanças (UI dedicada; ver config/finance.php)
# FINANCE_STANDALONE_UI=true

# Dados volumosos QA (transações, metas, cartões) em `php artisan db:seed`
# SEED_FINANCIAL_TEST_DATA=true

# CORS (API): lista separada por vírgulas ou * (ver config/cors.php)
# CORS_ALLOWED_ORIGINS=*
