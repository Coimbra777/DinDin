# Copie para .env.testing e ajuste credenciais.
# PHPUnit carrega .env.testing automaticamente quando o ficheiro existe (Laravel).

APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

# Base dedicada a testes (migrate:fresh apaga tudo). Ex.: nova_base_test
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nova_base_test
DB_USERNAME=root
DB_PASSWORD=

# Alternativa: SQLite em memória (requer extensão pdo_sqlite no PHP)
# DB_CONNECTION=sqlite
# DB_DATABASE=:memory:

BROADCAST_DRIVER=log
CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Opcional: ao correr `php artisan db:seed` em local, incluir dados volumosos de finanças QA
# SEED_FINANCIAL_TEST_DATA=true
